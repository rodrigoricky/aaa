{
  "name": "gnp-pos-backend",
  "version": "1.0.0",
  "description": "G&P Convenience Store POS Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "node --import tsx src/scripts/init-utility-schema.ts",
    "db:invadj": "node --import tsx src/scripts/db-invadj.ts",
    "db:invadj:dry": "node --import tsx src/scripts/db-invadj.ts --dry-run",
    "demo:on": "node --import tsx src/scripts/demo-on.ts",
    "demo:off": "node --import tsx src/scripts/demo-off.ts",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^9.1.11",
    "@types/node": "^20.11.30",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.2",
    "typescript": "^5.4.3"
  }
}
